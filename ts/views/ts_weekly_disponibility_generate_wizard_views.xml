<?xml version="1.0"?>
<odoo>
    <record id="ts_weekly_disponibility_generate_wizard_view_form" model="ir.ui.view">
        <field name="name">ts.weekly_disponibility.generate.wizard.form</field>
        <field name="model">ts.weekly_disponibility.generate.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p>
                    Generate availabilities from your weekly disponibilities for the
                    selected period. Availabilities previously generated for that period
                    are replaced; manually created ones are kept.
                </p>
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ts_weekly_disponibility_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generate Availabilities</field>
        <field name="res_model">ts.weekly_disponibility.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" eval="False"/>
    </record>
</odoo>
