<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="team_page_template" name="EVA Teams">
        <t t-call="website.layout">
            <div id="wrap">
                <section class="s_company_team_spotlight o_colored_level o_cc o_cc5 pt48 pb48">
                    <div class="container">
                        <h2 style="text-align: center;">Our Team</h2>
                        <div class="row">
                            <div t-foreach="players" t-as="player" class="col-6 col-lg-3">
                                <div class="s_card o_card_img_top card" data-vxml="001">
                                    <figure class="o_card_img_wrapper ratio ratio-1x1 mb-0">
                                        <img class="o_card_img card-img-top" t-att-src="image_data_uri(player.avatar_128)"/>
                                    </figure>
                                    <div t-attf-class="card-body o_colored_level o_cc #{'o_cc3' if player.id in captain_ids else 'o_cc4'}">
                                        <h3 class="card-title h5-fs" t-out="player.name"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
