#. module: ts
#: model:mail.template,body_html:ts.mail_template_meeting_minutes
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"                <p>Hello,</p>\n"
"                <p>\n"
"                    Please find attached the minutes for the meeting\n"
"                    <strong t-out=\"object.name\">Meeting</strong>\n"
"                    held on\n"
"                    <strong t-out=\"format_datetime(object.date)\">08/20/2026</strong>.\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"                <p>Bonjour,</p>\n"
"                <p>\n"
"                    Voici en fichier joint le PV de la réunion\n"
"                    <strong t-out=\"object.name\">Réunion</strong>\n"
"                    tenue le\n"
"                    <strong t-out=\"format_datetime(object.date)\">08/20/2026</strong>.\n"
"                </p>\n"
"            </div>\n"
"        "

#. module: ts
#: model:mail.template,body_html:ts.mail_template_meeting_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"                <p>Hello,</p>\n"
"                <p>\n"
"                    This is a reminder for the upcoming meeting\n"
"                    <strong t-out=\"object.name\">Meeting</strong>\n"
"                    scheduled on\n"
"                    <strong t-out=\"format_datetime(object.date)\">08/20/2026</strong>.\n"
"                </p>\n"
"                <p>Agenda:</p>\n"
"                <div t-out=\"object.agenda\"/>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"                <p>Bonjour,</p>\n"
"                <p>\n"
"                    Ceci est un rappel pour la réunion à venir\n"
"                    <strong t-out=\"object.name\">Réunion</strong>\n"
"                    programmée pour le\n"
"                    <strong t-out=\"format_datetime(object.date)\">08/20/2026</strong>.\n"
"                </p>\n"
"                <p>Ordre du Jour:</p>\n"
"                <div t-out=\"object.agenda\"/>\n"
"            </div>\n"
"        "

