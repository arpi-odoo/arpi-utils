<?xml version="1.0"?>
<odoo>
    <record id="eva_team_view_form" model="ir.ui.view">
        <field name="name">eva.team.form</field>
        <field name="model">eva.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_game_results"
                            class="oe_stat_button"
                            icon="bar_chart" icon_class="oi-filled"
                            type="object">
                            <div class="o_stat_info">
                                Results
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" options="{'line_breaks': False}" widget="text"/>
                        </h1>
                        <label for="short_name"/>
                        <h2>
                            <field name="short_name" options="{'line_breaks': False}" widget="text"/>
                        </h2>
                    </div>
                    <group>
                        <field name="player_ids" widget="many2many_tags"/>
                        <field name="captain_id" widget="many2one"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="eva_team_view_list" model="ir.ui.view">
        <field name="name">eva.team.list</field>
        <field name="model">eva.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="short_name"/>
                <field name="player_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="action_eva_team" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">eva.team</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>